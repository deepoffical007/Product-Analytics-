flowchart TD
    subgraph ST1["ST1 INTAKE — whoever receives it"]
        A["Issue received: WhatsApp · email · call · check-in · KAM · SE on site"] --> B["1.2 Log minimal record in PadCareOne<br/>Status: New · Owner: account CS owner"]
        B --> C{"1.3 Customer + site valid?"}
        C -- "Site not found / moved" --> C1["Log with 'Unverified site' flag"]
    end

    subgraph ST2["ST2 TRIAGE — CS"]
        D["2.1 Related-record panel: open + last-90-day cases at site / account"] --> E{"2.2 Asking about an issue already raised?"}
        E -- "Yes" --> E1{"Parent case found?"}
        E1 -- "Yes, open" --> E2["Add follow-up to parent · 'customer chased' flag · send update<br/>NO new case · parent stays open"]
        E1 -- "Yes, closed" --> E3{"Closed within last 14 days?"}
        E3 -- "Yes" --> RO["Reopen parent"]
        E3 -- "No" --> F
        E1 -- "No" --> E4["Create the underlying case<br/>flag: Not logged at receipt"]
        E4 --> F
        E -- "No" --> F{"Classify in order:<br/>Account-level? → Billing? → Failure of agreed service? → New request?"}
        F --> G{"2.3 Duplicate of an open case?"}
        G -- "Yes" --> G1["Closed – Duplicate · linked to parent"]
        G -- "No" --> H{"Second independent need?"}
        H -- "Yes" --> H1["Create linked case"]
        H -- "No" --> I
        H1 --> I["2.4 Recurrence check: same site + category, 90 days"]
        I --> J["2.5 Severity from impact rules<br/>Hygiene-Critical / Service-Impacting / Low-Impact<br/>+ escalators: recurrence · 3+ sites · overdue ≥3 days"]
        J --> K["2.6 Acknowledge customer: case ref + next step"]
    end

    subgraph ST3["ST3 ROUTE & ASSIGN — handoff protocol"]
        K --> L{"Case type"}
        L -- "Operational" --> L1["Hygiene-Critical: Ops City Manager + SE visit task<br/>else: scheduled SE"]
        L -- "Billing" --> L2["Finance"]
        L -- "Service request" --> L3["Ops City Manager · KAM approval if charges change"]
        L -- "Account-level" --> L4["KAM · else Ops City Manager"]
        L1 --> M
        L2 --> M
        L3 --> M
        L4 --> M
        M{"Status: Assigned<br/>Receiver accepts within R4?<br/>Sender accountable until then"}
        M -- "Returned: info missing" --> M2["Returned: In Progress with sender · completes info / On Hold – Customer · re-routes"]
        M2 --> L
        M -- "No response" --> M1["Escalate to receiver's escalation contact"]
        M1 --> M
        M -- "Accepts" --> N["Status: In Progress · ownership transfers"]
    end

    subgraph ST4["ST4 RESOLVE — resolution owner"]
        N --> O["4.1 Investigate + act: visit · invoice correction · installation · meeting"]
        O --> Q{"Needs another team?<br/>(decision → handoff · piece of work → linked task)"}
        Q -- "Yes: new handoff" --> L
        Q -- "Waiting on customer only" --> OH["On Hold – Customer · clock paused"]
        OH --> O
        O --> P{"SLA at risk / breached?"}
        P -- "Breached" --> P1["Escalation contact records a decision:<br/>reassign / take over / new date"]
        P1 --> O
        Q -- "No" --> S["4.4 Record resolution evidence by type · mandatory tasks done<br/>visit + proof · invoice / credit note no. + master fixed · install record · action plan"]
    end

    subgraph ST5["ST5 VERIFY & CLOSE — CS"]
        S --> T["Status: Awaiting Confirmation<br/>CS shares what was done and asks: resolved?"]
        T --> U{"Customer response"}
        U -- "Confirms (or SPOC signed off on site)" --> V["Closed – Confirmed"]
        U -- "Rejects" --> W["Back to In Progress · rejection +1<br/>2nd rejection → escalate"]
        W --> O
        U -- "No reply after 2 reminders (5 business days)" --> X["Closed – No Response"]
        V --> Y{"Issue returns?"}
        X --> Y
        Y -- "Within 14 days" --> RO
        Y -- "After 14 days" --> Z["New case linked as recurrence"]
    end

    C -- "Valid" --> D
    C1 --> D
    RO --> O
